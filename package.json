{
  "name": "llm-sizer",
  "version": "0.13.1",
  "private": true,
  "type": "module",
  "description": "Which open AI models fit your machine, and how fast: the memory maths, the fitted speed model, and the nightly model catalog behind theaibridges.com/tools/llm-sizer",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
