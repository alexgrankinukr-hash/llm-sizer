---
// The header this copy ships with: the tool's name and its three links. The upstream site has its own navigation.
// (No import from the tool here: the boundary script keeps the tool self-contained in both directions.)
const repo = 'https://github.com/alexgrankinukr-hash/llm-sizer';
---
<header id="site-header" class="w-full px-6 py-6 md:px-12 flex justify-between items-center border-b border-[var(--color-border)] relative z-40">
  <a href="/tools/llm-sizer" class="font-heading text-xl md:text-2xl font-bold tracking-tight text-[var(--color-text)] hover:text-[var(--color-accent)] transition-colors duration-500">
    LLM Sizer
  </a>
  <nav class="flex items-center gap-5 md:gap-8">
    <a href="/tools/llm-sizer" class="font-body text-xs uppercase tracking-[0.2em] text-[var(--color-muted)] hover:text-[var(--color-text)] transition-colors duration-300">The tool</a>
    <a href="/tools/llm-sizer/about" class="font-body text-xs uppercase tracking-[0.2em] text-[var(--color-muted)] hover:text-[var(--color-text)] transition-colors duration-300">How the numbers are made</a>
    <a href={repo} rel="noopener" class="font-body text-xs uppercase tracking-[0.2em] text-[var(--color-muted)] hover:text-[var(--color-text)] transition-colors duration-300">GitHub</a>
  </nav>
</header>
